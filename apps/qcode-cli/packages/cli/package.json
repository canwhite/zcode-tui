{
  "name": "@qcode/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Main CLI application for qcode",
  "bin": {
    "qcode": "./dist/qcode.cjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/qcode.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop-agent": "node scripts/build.mjs --desktop-agent",
    "build:sea": "pnpm --dir ../../../.. exec turbo --skip-infer --cwd apps/qcode-cli run build --filter=!@zcode/cli --force && pnpm build && node scripts/build-sea.mjs --all",
    "sea": "node scripts/build-sea.mjs",
    "upload:sea": "node scripts/upload-sea-smb.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@qcode/adapters": "workspace:*",
    "@qcode/bootstrap": "workspace:*",
    "@qcode/contracts": "workspace:*",
    "@qcode/core": "workspace:*",
    "@qcode/dynamic-workflow-runtime": "workspace:*",
    "@qcode/i18n": "workspace:*",
    "@qcode/provider": "workspace:*",
    "@qcode/provider-node": "workspace:*",
    "@qcode/shared": "workspace:*",
    "@qcode/shared-types": "workspace:*",
    "@qcode/tui": "workspace:*",
    "dotenv": "^17.4.2",
    "playwright-core": "1.59.1"
  }
}
